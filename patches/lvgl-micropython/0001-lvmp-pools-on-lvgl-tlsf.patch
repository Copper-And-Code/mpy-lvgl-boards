diff --git a/src/lvmp_pool.h b/src/lvmp_pool.h
new file mode 100644
index 0000000..1fb7ea0
--- /dev/null
+++ b/src/lvmp_pool.h
@@ -0,0 +1,24 @@
+// LVGL allocations from TLSF pools kept in GC blocks (lv_mem_core_micropython.c).
+// Shared with lvgl_micropython_build.c, which registers the pools' root pointer
+// (make builds scan only SRC_USERMOD_C for root pointers, not the LVGL sources),
+// and lvmp_tlsf.c, which sizes LVGL's TLSF for one pool.
+#ifndef LVMP_POOL_H
+#define LVMP_POOL_H
+
+#include "py/mpconfig.h"
+
+// ESP32: ESP-IDF's multi_heap. Other ports: LVGL's TLSF, when the board sets
+// LVMP_POOL_TLSF=1.
+#if defined(ESP_PLATFORM) && MICROPY_MALLOC_USES_ALLOCATED_SIZE
+#define LVMP_POOL (1)
+#elif defined(LVMP_POOL_TLSF) && LVMP_POOL_TLSF
+#define LVMP_POOL (1)
+#else
+#define LVMP_POOL (0)
+#endif
+
+#define LVMP_POOL_MAX   (8)
+#define LVMP_POOL_BYTES (256 * 1024)
+#define LVMP_POOL_BIG   (32 * 1024)
+
+#endif // LVMP_POOL_H
diff --git a/src/lvmp_tlsf.c b/src/lvmp_tlsf.c
new file mode 100644
index 0000000..a319f41
--- /dev/null
+++ b/src/lvmp_tlsf.c
@@ -0,0 +1,19 @@
+/**
+ * @file lvmp_tlsf.c
+ *
+ * LVGL's TLSF allocator for the LVMP pools of lv_mem_core_micropython.c on
+ * ports without ESP-IDF's multi_heap (LVMP_POOL_TLSF=1). LVGL compiles
+ * lv_tlsf.c only with LV_STDLIB_BUILTIN, so it is built here, in a translation
+ * unit of its own, with that setting: nothing else in LVGL changes.
+ */
+#include "lvgl/src/lv_conf_internal.h"
+#if LV_USE_STDLIB_MALLOC == LV_STDLIB_MICROPYTHON_OVERRIDE && defined(LVMP_POOL_TLSF) && LVMP_POOL_TLSF
+#include "lvmp_pool.h"
+#undef LV_USE_STDLIB_MALLOC
+#define LV_USE_STDLIB_MALLOC LV_STDLIB_BUILTIN
+// lv_tlsf.c sizes its tables for LV_MEM_SIZE + LV_MEM_POOL_EXPAND_SIZE, which
+// lv_conf_internal.h defines only with LV_STDLIB_BUILTIN: one TLSF per pool.
+#define LV_MEM_SIZE LVMP_POOL_BYTES
+#define LV_MEM_POOL_EXPAND_SIZE 0
+#include "lvgl/src/stdlib/builtin/lv_tlsf.c"
+#endif
