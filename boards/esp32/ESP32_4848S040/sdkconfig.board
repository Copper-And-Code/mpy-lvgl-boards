CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# The panel keeps running while the flash is written: its interrupt and the bounce
# buffers are in internal RAM, and code and constants run from PSRAM.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Bigger caches: LVGL's code, the framebuffers and the heap are all in PSRAM. A full
# redraw of 48 buttons goes from 133 to 88 ms, for 16 KB of internal RAM.
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
